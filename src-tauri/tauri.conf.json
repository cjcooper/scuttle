{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Container Desktop",
  "version": "0.1.0",
  "identifier": "com.it-problems.container-desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Container Desktop",
        "width": 1100,
        "height": 720,
        "minWidth": 760,
        "minHeight": 480,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/256x256.png",
      "icons/32x32.png",
      "icons/48x48.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png",
      "icons/AppIcon.icon"
    ],
    "publisher": "it-problems",
    "copyright": "Copyright © 2026 it-problems",
    "shortDescription": "Menu bar controller for Colima, Docker and similar container runtimes",
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
